{
  "tenant": "archipelago-resorts",
  "locale": "en",
  "primaryColor": "#0E7490",
  "welcomeMessage": "Welcome to Archipelago Resorts — explore island careers with Meridian, your concierge.",
  "voiceEnabled": true,
  "snapGrid": true,
  "canvasMode": "bounded",
  "canvasBounds": "1200x800",
  "canvasZoom": "locked",
  "greetingMode": "agent-first",
  "persona": {
    "assistantName": "Meridian",
    "tenantTitle": "Island Career Concierge",
    "systemPrompt": "You are Meridian, the Archipelago Resorts career concierge. Share fictional island hospitality roles only.",
    "voiceGreeting": "Welcome — I'm Meridian, your Archipelago Resorts career guide. Ask about island roles, growth paths, or hospitality tracks.",
    "greetingMode": "agent-first",
    "visual": {
      "type": "halo",
      "showInChat": true,
      "showInHeader": true
    },
    "starterPrompts": [
      { "emoji": "🌴", "label": "Island roles", "text": "Show open island hospitality roles." },
      { "emoji": "📈", "label": "Growth paths", "text": "Where can a guest associate grow in five years?" }
    ]
  },
  "adapter": {
    "kind": "static",
    "dataUrl": "/examples/shared/archipelago-career-data.json"
  },
  "toolbar": {
    "tools": [
      "select",
      "draw",
      "hand",
      "layers",
      "voice",
      "attach",
      "recent-activity",
      "screenshot",
      "dock-menu",
      "auto-arrange",
      "reset"
    ],
    "layoutActionPlacement": "toolbar",
    "customActions": [
      { "id": "attach", "label": "Attach", "icon": "paperclip", "placement": "toolbar" },
      { "id": "recent-activity", "label": "Recent activity", "icon": "clock", "placement": "toolbar" },
      { "id": "screenshot", "label": "Screenshot", "icon": "camera", "placement": "toolbar" },
      { "id": "dock-menu", "label": "Dock", "icon": "layout-grid", "placement": "toolbar" }
    ]
  },
  "panels": [
    { "id": "open-positions", "kind": "react" },
    { "id": "applications", "kind": "react" },
    { "id": "growth-paths", "kind": "react" },
    { "id": "resources", "kind": "react" },
    { "id": "settings", "kind": "react" },
    { "id": "resume-docs", "kind": "react" },
    { "id": "career-tools", "kind": "react" },
    { "id": "journey", "kind": "react" },
    { "id": "recent-activity", "kind": "react" }
  ]
}
