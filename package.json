{
  "name": "agentable-canvas",
  "version": "0.3.0",
  "type": "module",
  "description": "Embeddable AI canvas web component — Lit shell + React internals + voice (Gemini Live) + a draggable-panel workspace. Drop into any page; brand via CSS tokens; isolate with Shadow DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikehenken/agentable.git"
  },
  "homepage": "https://github.com/mikehenken/agentable#readme",
  "bugs": {
    "url": "https://github.com/mikehenken/agentable/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "ai",
    "web-component",
    "lit",
    "react",
    "canvas",
    "voice",
    "gemini-live",
    "shadow-dom",
    "embeddable",
    "agent",
    "whiteboard"
  ],
  "files": [
    "src",
    "dist",
    "scripts",
    "vite.config.ts",
    "vite.embed.config.ts",
    "vite.embed-button.config.ts",
    "tailwind.config.js",
    "postcss.config.js",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "components.json",
    "README.md",
    "EMBEDDING.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/react/index.tsx",
    "./react": "./src/react/index.tsx",
    "./react-canvas": "./src/react-canvas/index.tsx",
    "./whiteboard": "./src/whiteboard/index.tsx",
    "./copilotkit-bridge": "./src/canvas/protocol/copilotkit-bridge.tsx",
    "./i18n": "./src/i18n/index.ts",
    "./general": "./src/components/general/index.ts",
    "./ui-ai": "./src/components/ui-ai/index.ts",
    "./orchestration": "./src/components/orchestration/index.ts",
    "./orchestration/tokens.css": "./src/components/orchestration/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./styles.source.css": "./src/index.css",
    "./utils/hex-to-hsl": "./src/embed/utils/hexToHsl.ts",
    "./embed": "./dist/embed/agentable-canvas.js",
    "./embed/canvas": "./dist/embed/agentable-canvas.js",
    "./embed/voice-call-button": "./dist/embed/voice-call-button.js",
    "./embed/agentable-canvas.css": "./dist/embed/agentable-canvas.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare": "node scripts/prepare-install.mjs",
    "build:embed": "vite build --config vite.embed.config.ts && npm run build:embed:button",
    "build:embed:button": "vite build --config vite.embed-button.config.ts",
    "build:embed:all": "npm run build:embed && npm run build:styles && npm run check:bundle",
    "build:styles": "node scripts/build-styles.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "web-test-runner --config web-test-runner.config.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "build:embed:site": "vite build --config vite.embed.config.ts && vite build --config vite.embed-button.config.ts && vite build --config vite.embed-panel.config.ts && vite build --config vite.embed-whiteboard.config.ts && vite build --config vite.embed-app-shell.config.ts && vite build --config vite.embed-starter-chip.config.ts && vite build --config vite.embed-agent-status.config.ts && vite build --config vite.embed-ask-about.config.ts && vite build --config vite.embed-career-whiteboard.config.ts && vite build --config vite.embed-gallery-13-chrome.config.ts && vite build --config vite.embed-operator-surface-placement.config.ts && vite build --config vite.embed-iframe-host.config.ts",
    "build:examples-site": "npm run build:embed:site && node scripts/build-examples-site.mjs",
    "test:release": "vitest run --config vitest.release.config.ts"
  },
  "dependencies": {
