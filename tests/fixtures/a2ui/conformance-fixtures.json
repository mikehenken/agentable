[
  {
    "id": "user-profile-card",
    "description": "A2UI v1.0 createSurface user profile card (spec example) with path-bound Text",
    "messages": [
      {
        "version": "v1.0",
        "createSurface": {
          "surfaceId": "user_profile_card",
          "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
          "components": [
            {
              "id": "root",
              "component": "Column",
              "children": ["user_name"]
            },
            {
              "id": "user_name",
              "component": "Text",
              "text": { "path": "/name" }
            }
          ],
          "dataModel": {
            "name": "John Doe"
          }
        }
      }
    ],
    "expectedIr": {
      "v": 1,
      "origin": "agent",
      "root": "root",
      "state": {
        "name": "John Doe"
      },
      "nodes": {
        "root": {
          "type": "panel-body",
          "children": ["user_name"]
        },
        "user_name": {
          "type": "header",
          "props": {
            "title": "John Doe"
          }
        }
      }
    },
    "validation": {
      "adapterSources": [],
      "hostActions": [],
      "panelRegistry": []
    }
  },
  {
    "id": "dual-text-column",
    "description": "A2UI v1.0 updateComponents dual Text under Column (spec example)",
    "messages": [
      {
        "version": "v1.0",
        "updateComponents": {
          "surfaceId": "user_profile_card",
          "components": [
            {
              "id": "root",
              "component": "Column",
              "children": ["user_name", "user_title"]
            },
            {
              "id": "user_name",
              "component": "Text",
              "text": "John Doe"
            },
            {
              "id": "user_title",
              "component": "Text",
              "text": "Software Engineer",
              "variant": "caption"
            }
          ]
        }
      }
    ],
    "expectedIr": {
      "v": 1,
      "origin": "agent",
      "root": "root",
      "nodes": {
        "root": {
          "type": "panel-body",
          "children": ["user_name", "user_title"]
        },
        "user_name": {
          "type": "header",
          "props": {
            "title": "John Doe"
          }
        },
        "user_title": {
          "type": "badge",
          "props": {
            "text": "Software Engineer"
          }
        }
      }
    },
    "validation": {
      "adapterSources": [],
      "hostActions": [],
      "panelRegistry": []
    }
  },
